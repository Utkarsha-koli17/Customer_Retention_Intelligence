<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Customer Retention Intelligence Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root{--bg:#0e0e11;--card:#17171c;--line:#2a2a33;--tx:#f2f2f5;--mu:#9a9aa8;--ac:#a78bfa;--bl:#3b82f6;--hi:#f87171;--me:#fbbf24;--lo:#34d399}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font:14px/1.45 Inter,system-ui,sans-serif}
.app{display:grid;grid-template-columns:270px 1fr;min-height:100vh}
aside{padding:20px;border-right:1px solid var(--line);position:sticky;top:0;height:100vh;overflow:auto}
aside h2{font-size:18px;margin:0 0 4px}aside p{color:var(--mu);margin:0 0 18px;font-size:12px}
label{display:block;color:var(--mu);font-size:12px;margin:12px 0 4px}
select,input{width:100%;background:#111116;color:var(--tx);border:1px solid var(--line);border-radius:8px;padding:9px;font:inherit}
select:focus,input:focus,button:focus-visible{outline:2px solid var(--ac)}
button{margin-top:16px;width:100%;background:var(--ac);color:#17102b;border:0;border-radius:8px;padding:10px;font-weight:700;cursor:pointer}
main{padding:22px 26px;min-width:0}
h1{font-size:24px;margin:0}.sub{color:var(--mu);margin:2px 0 18px}
.grid{display:grid;gap:16px;margin-bottom:16px}.k{grid-template-columns:repeat(auto-fit,minmax(170px,1fr))}
.g2{grid-template-columns:repeat(auto-fit,minmax(340px,1fr))}.g3{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;min-width:0}
.card h3{margin:0 0 2px;font-size:15px}.card .n{color:var(--mu);font-size:12px;margin:0 0 10px}
.kpi b{display:block;font-size:30px;font-weight:800;margin-top:4px}.kpi span{color:var(--mu);font-size:12px}
.ch{position:relative;height:230px}
table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:7px 8px;border-bottom:1px solid var(--line);white-space:nowrap}
th{color:var(--mu);font-weight:500}.wrap{overflow-x:auto}
.tag{padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600}
.High{background:#f8717126;color:var(--hi)}.Medium{background:#fbbf2426;color:var(--me)}.Low{background:#34d39926;color:var(--lo)}
ul{margin:0;padding-left:18px}li{margin:6px 0}
.empty{color:var(--mu);padding:30px;text-align:center}
@media(max-width:820px){.app{grid-template-columns:1fr}aside{position:static;height:auto;border:0;border-bottom:1px solid var(--line)}}
</style></head><body>
<div class="app">
<aside>
<h2>Filters</h2><p>Every chart, card and table updates as you filter.</p>
<label for="fRisk">Risk category</label><select id="fRisk"></select>
<label for="fAct">Retention action</label><select id="fAct"></select>
<label for="fSeg">Customer value segment</label><select id="fSeg"></select>
<label for="fRec">Recency band</label><select id="fRec"></select>
<label for="fFre">Frequency band</label><select id="fFre"></select>
<label for="fLif">Lifespan band</label><select id="fLif"></select>
<label for="fId">Customer ID</label><input id="fId" inputmode="numeric" placeholder="e.g. 14090">
<button id="reset">Reset filters</button>
</aside>
<main>
<h1>Customer Retention Intelligence</h1>
<div class="sub" id="sub"></div>
<div class="grid k" id="kpis"></div>
<div class="grid g3">
 <div class="card"><h3>Customers by risk</h3><p class="n" id="riskN"></p><div class="ch"><canvas id="c1"></canvas></div></div>
 <div class="card"><h3>Revenue at risk by category</h3><p class="n">Total estimated revenue at risk</p><div class="ch"><canvas id="c2"></canvas></div></div>
 <div class="card"><h3>Retention actions</h3><p class="n">Customers per recommended action</p><div class="ch"><canvas id="c3"></canvas></div></div>
</div>
<div class="grid g3">
 <div class="card"><h3>Recency vs churn</h3><p class="n">Average churn probability (%)</p><div class="ch"><canvas id="c4"></canvas></div></div>
 <div class="card"><h3>Frequency vs churn</h3><p class="n">Average churn probability (%)</p><div class="ch"><canvas id="c5"></canvas></div></div>
 <div class="card"><h3>Lifespan vs churn</h3><p class="n">Average churn probability (%)</p><div class="ch"><canvas id="c6"></canvas></div></div>
</div>
<div class="grid g3">
 <div class="card"><h3>Products bought vs churn</h3><p class="n">Average churn probability (%) by unique products</p><div class="ch"><canvas id="c7"></canvas></div></div>
 <div class="card"><h3>Monetary value by risk</h3><p class="n">Median spend per customer</p><div class="ch"><canvas id="c8"></canvas></div></div>
 <div class="card"><h3>Churn probability spread</h3><p class="n">Customers per 10-point churn bucket</p><div class="ch"><canvas id="c9"></canvas></div></div>
</div>
<div class="grid g2">
 <div class="card"><h3>Action priority</h3><p class="n">Which action to fund first: revenue at risk, total and per customer</p><div class="wrap" id="actT"></div></div>
 <div class="card"><h3>Segment priority</h3><p class="n">Revenue at risk by value segment and risk category</p><div class="wrap" id="segT"></div></div>
</div>
<div class="grid g2">
 <div class="card"><h3>Highest churn probability</h3><p class="n">Top 10 customers in the current filter</p><div class="wrap" id="topT"></div></div>
 <div class="card"><h3>High-value customers at risk</h3><p class="n">High Value segment, Medium or High risk, top 10 by revenue at risk</p><div class="wrap" id="vipT"></div></div>
</div>
<div class="card"><h3>What the data says</h3><p class="n">Written from the filtered customers</p><ul id="ins"></ul></div>
</main></div>
